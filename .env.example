# secscan-redteam — environment configuration
#
# Copy to .env (gitignored) and fill in only what you need for the
# engagement you're running. Everything here is optional at the process
# level — the runner fails closed per-feature with a clear reason when a
# var is missing, rather than refusing to start. Secrets belong in your
# Secure Vault in production; .env is for local/dev use only.
#
# See docs/safety.md, docs/integrations.md, docs/architecture.md.

# ─────────────────────────────────────────────────────────────────────────
# LLM providers (llm-router) — at least one is required to run agents at all
# ─────────────────────────────────────────────────────────────────────────

# DeepSeek (flash) — primary reasoning model for the agent team.
DEEPSEEK_API_KEY=

# Qwen (qwen3.8-max) — secondary reasoning model. QWEN_API_KEY preferred;
# DASHSCOPE_API_KEY is the fallback var if that's what your account issues.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
# Override only if you're on a non-default Qwen/DashScope region or gateway.
QWEN_BASE_URL=

# ─────────────────────────────────────────────────────────────────────────
# SecScan MCP (harness-plugin auth gate) — server-authoritative domain proof
# ─────────────────────────────────────────────────────────────────────────

# API token for the SecScan MCP endpoint. Without this, the gate can never
# server-verify a domain and falls back to SECSCAN_VERIFIED_DOMAINS only.
SECSCAN_MCP_TOKEN=
# Default: https://secscan.us/api/mcp — override only for a different
# SecScan deployment.
SECSCAN_MCP_URL=
# Secondary/manual allowlist for domains verified out-of-band (comma-
# separated hostnames). Prefer server verification; this is a fallback.
SECSCAN_VERIFIED_DOMAINS=

# ─────────────────────────────────────────────────────────────────────────
# Engagement environment / tier / safety graduation
# ─────────────────────────────────────────────────────────────────────────

# staging (default) | production — production is a deliberate, explicit act.
REDTEAM_ENV=staging
# Required alongside REDTEAM_ENV=production, or pass --confirm-production.
REDTEAM_PROD_CONFIRM=
# Attack-battery tier selection; see docs/attack-batteries.md.
REDTEAM_TIER=
# Required to run tier-2 batteries against production.
REDTEAM_TIER2_PROD_CONFIRM=
# Name recorded as accountable operator in reports/compliance pack.
REDTEAM_OPERATOR=
# Where the runner stores engagement state/audit logs. Defaults to a
# platform-appropriate app-data directory if unset.
REDTEAM_HOME=
# Log rotation caps for long/watch runs.
REDTEAM_LOG_MAX_BYTES=
REDTEAM_LOG_MAX_ARCHIVES=

# ─────────────────────────────────────────────────────────────────────────
# Web console (runner ui) — loopback-only dashboard
# ─────────────────────────────────────────────────────────────────────────

# Fixed startup token instead of a freshly generated one each launch.
REDTEAM_UI_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Host-exec credentials — ONLY for hosts explicitly in ROE scope.
# Test-account credentials only. Never shared or production accounts.
# ─────────────────────────────────────────────────────────────────────────

# SSH
REDTEAM_SSH_USER=
REDTEAM_SSH_PASSWORD=
REDTEAM_SSH_KEY=
REDTEAM_SSH_KEY_PATH=
REDTEAM_SSH_AGENT_SOCKET=

# SMB
REDTEAM_SMB_USER=
REDTEAM_SMB_PASSWORD=
REDTEAM_SMB_DOMAIN=
REDTEAM_SMB_NTHASH=

# WinRM
REDTEAM_WINRM_USER=
REDTEAM_WINRM_PASSWORD=

# Active Directory / LDAP
REDTEAM_AD_USER=
REDTEAM_AD_PASSWORD=
REDTEAM_AD_DOMAIN=

# Kerberos
REDTEAM_KRB_USER=
REDTEAM_KRB_PASSWORD=
REDTEAM_KRB_DOMAIN=
REDTEAM_KRB_CCACHE_PATH=
REDTEAM_KRB_CCACHE_B64=
REDTEAM_KRB_KIRBI_B64=

# NFS (test-client hostname used to exercise NFS exports)
REDTEAM_NFS_TEST_CLIENT=

# ─────────────────────────────────────────────────────────────────────────
# Metasploit RPC (msf executor) — canary-only validated-exploit execution
# ─────────────────────────────────────────────────────────────────────────

REDTEAM_MSFRPC_HOST=
REDTEAM_MSFRPC_PORT=
REDTEAM_MSFRPC_USER=
REDTEAM_MSFRPC_PASS=
REDTEAM_MSFRPC_TLS=

# ─────────────────────────────────────────────────────────────────────────
# Nuclei template bridge
# ─────────────────────────────────────────────────────────────────────────

# Path to the nuclei binary. Required for the nuclei-backed checks to run.
REDTEAM_NUCLEI_BIN=
# Directory of nuclei templates, if not using the bundled/resolved set.
REDTEAM_NUCLEI_TEMPLATES=
REDTEAM_NUCLEI_TIMEOUT_S=

# ─────────────────────────────────────────────────────────────────────────
# Integrations — findings delivery (all optional; fail closed with reason)
# ─────────────────────────────────────────────────────────────────────────

# Jira
REDTEAM_JIRA_BASE_URL=
REDTEAM_JIRA_USER=
REDTEAM_JIRA_API_TOKEN=
REDTEAM_JIRA_PROJECT=
REDTEAM_JIRA_ISSUE_TYPE=
# JSON map overriding severity->Jira priority id, e.g. {"critical":"1"}
REDTEAM_JIRA_PRIORITY_MAP=

# ServiceNow
REDTEAM_SNOW_INSTANCE=
REDTEAM_SNOW_USER=
REDTEAM_SNOW_PASSWORD=
REDTEAM_SNOW_TABLE=

# Slack
REDTEAM_SLACK_WEBHOOK_URL=
