# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-test/
build/
*.tsbuildinfo

# Secrets — NEVER commit these. Keys live in the environment / Secure Vault only.
.env
.env.*
!.env.example
*.pem
*.key

# Harness / editor state
.dsh/
.agent-teams/
*.log
.DS_Store

# Test artifacts — anchored to the two places vitest/jest actually emit
# coverage reports. Do NOT use a bare `coverage/` here: it would also
# swallow runner/src/coverage/, which is real source (verdict ledger).
/coverage/
runner/coverage/

# Runner runtime state (re-seeds / re-creates on first run)
runner/engagements/

# Live-engagement runtime output written by the CLI/UI from the repo root
# (per-engagement dirs + queued jobs). May contain client/target data —
# NEVER commit it. The directories themselves are kept via .gitkeep.
engagements/live/*
!engagements/live/.gitkeep
engagements/queue/*
!engagements/queue/.gitkeep
